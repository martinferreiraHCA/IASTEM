# Copia este archivo como .env si querés cambiar algo. No hace falta: sin
# archivo el servidor arranca igual y NOVA responde solo con el guion.

# Opcional: puerto del servidor local
PORT=3000

# Opcional: el asistente de ubicación. Con una clave, cuando lo que se oye
# no coincide con un pie, se le pregunta a una IA a qué pie corresponde.
# La IA nunca escribe lo que dice NOVA: solo ubica. La clave vive acá y el
# navegador nunca la ve. Sin clave, NOVA ubica los pies por parecido.
#
# Con Claude (Anthropic). Si está esta clave, se usa esta.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
#
# O con OpenAI.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
