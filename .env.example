# Copia este archivo como .env y completa tu clave.
# La clave NUNCA se expone al navegador: solo la usa el servidor.
#
# Sin este archivo la página igual arranca, en modo demo, con respuestas
# guionadas. No hace falta configurar nada para probarla.

OPENAI_API_KEY=sk-...

# Opcional: modelo a usar (por defecto gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Opcional: endpoint compatible con la API de OpenAI
# (sirve para Azure, OpenRouter, Groq, LM Studio, Ollama, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# Opcional: puerto del servidor local
PORT=3000

# Opcional: forzar el modo demo aunque haya clave (DEMO=1)
# DEMO=1

# Opcional: personalidad de la IA
SYSTEM_PROMPT=Sos NOVA, una inteligencia artificial conversacional. Respondes en español rioplatense, con claridad y calidez. Sos concisa salvo que te pidan detalle.
